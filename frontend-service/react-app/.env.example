# Copy to `.env` or `.env.local`. Vite proxies /ui-api to this URL during `npm run dev`.
#
# Option A — Java on your machine (default port 8088):
#   From repo root: gradlew :frontend-service:bootRun
#
# Option B — frontend-service in Docker (compose maps 8088:8088):
#   docker compose up -d frontend-service
#   Then keep VITE_UI_API_PROXY=http://127.0.0.1:8088
#
VITE_UI_API_PROXY=http://127.0.0.1:8088
